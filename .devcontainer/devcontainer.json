{
    "name": "secure-dev-env",
    "dockerComposeFile": [
        "./docker-compose-dev.yml"
    ],
    "service": "dev",
    "workspaceFolder": "/workspace",
    "remoteUser": "vscode",
    "customizations": {
        "vscode": {
            "extensions": [
                "golang.Go",
                "ms-python.python"
            ]
        }
    },
    "postCreateCommand": "mise install",
    "features": {
        "ghcr.io/devcontainers/features/docker-in-docker:2": {
            "version": "latest",
            "moby": false
        }
    }
}