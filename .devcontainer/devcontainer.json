{
    "name": "secure-dev-env",
    "dockerComposeFile": [
        "./docker-compose-dev.yml"
    ],
    "service": "dev",
    "workspaceFolder": "/workspace",
    "remoteUser": "vscode",
    "customizations": {
        "vscode": {
            "extensions": [
                "golang.Go"
            ]
        }
    },
    "postCreateCommand": "mise install"
}